{
  "name": "pixicity",
  "version": "0.6.1",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadlessCI",
    "icons": "node scripts/build-icon-subset.js",
    "icons:check": "node scripts/build-icon-subset.js --check",
    "any:check": "node scripts/check-any.js",
    "e2e": "playwright test",
    "check:responsive": "ng build --configuration development --output-path dist/check && node scripts/responsive-check.js",
    "serve:ssr:pixicity": "node dist/pixicity/server/server.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.14",
    "@angular/cdk": "^21.2.12",
    "@angular/common": "^21.2.14",
    "@angular/compiler": "^21.2.14",
    "@angular/core": "^21.2.14",
    "@angular/forms": "^21.2.14",
    "@angular/material": "^21.2.12",
    "@angular/platform-browser": "^21.2.14",
    "@angular/platform-browser-dynamic": "^21.2.14",
    "@angular/platform-server": "^21.2.14",
    "@angular/router": "^21.2.14",
    "@angular/ssr": "^21.2.24",
    "@microsoft/signalr": "^10.0.0",
    "@tabler/icons-webfont": "^3.34.1",
    "animate.css": "^4.1.1",
    "bootstrap": "^5.3.8",
    "express": "^5.1.0",
    "jwt-decode": "^4.0.0",
    "material-icons": "^1.13.14",
    "ng-recaptcha": "^13.2.1",
    "ngx-image-cropper": "^9.1.6",
    "ngx-toastr": "^20.0.5",
    "ngx-ui-loader": "^19.0.0",
    "rxjs": "~7.8",
    "tslib": "^2.8.1",
    "zone.js": "^0.16.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.12",
    "@angular/cli": "^21.2.12",
    "@angular/compiler-cli": "^21.2.14",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.63.0",
    "@types/express": "^5.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^25.9.1",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "subset-font": "^2.9.0",
    "typescript": "~5.9.3"
  }
}
